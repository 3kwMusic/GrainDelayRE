function(grain_target_legal_notices target)
    get_filename_component(root "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/.." ABSOLUTE)
    file(GLOB notices CONFIGURE_DEPENDS "${root}/licenses/*")
    set(inputs "${root}/LICENSE" "${root}/THIRD_PARTY_NOTICES.md" ${notices})
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${inputs} "${root}/CMakeLists.txt")
    file(READ "${root}/CMakeLists.txt" project_cmake)
    string(REGEX MATCH "project\\(GrainDelayRE VERSION ([0-9.]+)\\)" unused "${project_cmake}")
    set(version "${CMAKE_MATCH_1}")
    if(NOT version)
        message(FATAL_ERROR "Cannot determine Grain Delay RE version")
    endif()
    set(text "Grain Delay RE ${version}\nCopyright (C) 2026 TriM\n\nAGPL-3.0-only. You may modify and redistribute this software under that license.\nNO WARRANTY, to the extent permitted by law; see sections 15 and 16 below.\nCommercial music production and distribution of your audio works are allowed.\nSource: https://github.com/3kwMusic/GrainDelayRE/tree/v${version}\n\n")
    foreach(input IN LISTS inputs)
        get_filename_component(name "${input}" NAME)
        file(READ "${input}" content)
        string(APPEND text "\n========== ${name} ==========\n\n${content}\n")
    endforeach()
    if(text MATCHES "\\)GRAINLEGAL\"")
        message(FATAL_ERROR "Legal text contains the reserved string delimiter")
    endif()
    file(MAKE_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/legal")
    set(header "${CMAKE_CURRENT_BINARY_DIR}/legal/GrainDelayLegalData.h")
    set(generated "#pragma once\nnamespace GrainDelayLegalData { inline constexpr const char* parts[] = {\n")
    string(LENGTH "${text}" remaining)
    while(remaining GREATER 0)
        if(remaining GREATER 4096)
            string(SUBSTRING "${text}" 0 4096 chunk)
            string(FIND "${chunk}" "\n" end REVERSE)
            if(end LESS 0)
                message(FATAL_ERROR "Legal text has a line exceeding the embedding limit")
            endif()
            math(EXPR count "${end} + 1")
        else()
            set(count ${remaining})
        endif()
        string(SUBSTRING "${text}" 0 ${count} chunk)
        string(APPEND generated "u8R\"GRAINLEGAL(${chunk})GRAINLEGAL\",\n")
        string(SUBSTRING "${text}" ${count} -1 text)
        string(LENGTH "${text}" remaining)
    endwhile()
    string(APPEND generated "}; }\n")
    file(WRITE "${header}" "${generated}")
    target_include_directories(${target} PRIVATE "${CMAKE_CURRENT_BINARY_DIR}/legal")
    target_sources(${target} PRIVATE "${header}")
    if(MSVC)
        target_compile_options(${target} PRIVATE /utf-8)
    endif()
endfunction()
